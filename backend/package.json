{
  "name": "gomax-api",
  "version": "1.0.0",
  "private": true,
  "description": "GoMax API for the v3 Applicator app and Admin website - Cloud Run (GCP) + Supabase Postgres",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:local": "tsx --env-file-if-exists=.env src/dev.ts",
    "rzp:webhook": "tsx --env-file-if-exists=.env scripts/rzp-webhook.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/main.js",
    "migrate": "node dist/db/migrate.js",
    "seed": "node dist/db/seed.js",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "load:seed": "tsx load/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@google-cloud/storage": "^8.4.0",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "google-auth-library": "^11.3.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
