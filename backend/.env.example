# Copy to .env (never commit it). `npm run dev` uses this database; `npm run dev:local` ignores
# DATABASE_URL and uses a throwaway database in ./.data.
#
# Supabase → your project → Connect:
#   DATABASE_URL = Transaction pooler (port 6543), used by the running API
#   DIRECT_URL   = Session pooler (port 5432), used by migrations
# Put in your database password. If it has symbols like @ # / : encode them (@ = %40, # = %23, / = %2F, : = %3A).
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Supabase root CA (PEM). Optional locally; required in production.
DB_CA_CERT=
REDIS_URL=

# At least 32 characters:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts PAN numbers. Keep it forever for this database: a new key makes saved PANs unreadable.
PAN_KEY=
JOBS_SECRET=

# First admin login, created by `npm run db:seed` (safe to re-run).
SEED_OWNER_LOGIN=owner
SEED_OWNER_PASSWORD=
SEED_OWNER_PIN=
# 1 = also add the demo applicator and coupon batch. For testing only, remove before real use.
SEED_DEMO=1

STORAGE_DRIVER=memory
WHATSAPP_DRIVER=log
CORS_ORIGINS=*
APP_LINK_BASE=https://gomax.app
# Sign-up SMS OTP (Firebase Phone Auth). Empty = sign-up without OTP.
FIREBASE_PROJECT_ID=
# Payouts: manual (staff pay by UPI app) or razorpayx (automatic). UPI name check: mock or razorpay.
PAYOUT_MODE=manual
KYC_DRIVER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAY_WEBHOOK_SECRET=
